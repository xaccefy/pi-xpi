{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun"]
  },
  "include": [
    "packages/pi-casefile/src/**/*.ts",
    "packages/pi-casefile/test/**/*.ts",
    "packages/pi-shared/src/**/*.ts",
    "packages/pi-webxp/src/**/*.ts",
    "packages/pi-webxp/test/**/*.ts",
    "packages/pi-xtodo/index.ts",
    "packages/pi-xtodo/test/**/*.ts",
    "test-utils.ts"
  ]
}
