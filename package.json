{
  "name": "@xaccefy/pi-xpi",
  "version": "0.9.4",
  "description": "XPI — offensive security tools for Pi Agent. Casefile tracking, web search, library docs, exploit technique search, and todo tracking.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "xpi",
    "security",
    "bug-bounty",
    "pentest",
    "ctf",
    "exploit",
    "web-search"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaccefy/pi-xpi.git"
  },
  "homepage": "https://github.com/xaccefy/pi-xpi#readme",
  "bugs": {
    "url": "https://github.com/xaccefy/pi-xpi/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "plugin.json",
    "agents/",
    "skills/",
    "schemas/",
    "docs/",
    "packages/pi-casefile/src/",
    "packages/pi-casefile/skills/",
    "packages/pi-webxp/src/",
    "packages/pi-xtodo/index.ts",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-casefile/src/index.ts",
      "./packages/pi-webxp/src/index.ts",
      "./packages/pi-xtodo/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "dependencies": {
    "@xaccefy/pi-shared": "0.9.4",
    "open-websearch": "^2.1.11",
    "tough-cookie": "^6.0.2",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/bun": "^1.3.14",
    "typebox": "1.1.38",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "scripts": {
    "test": "bun test --isolate",
    "bench": "bun bench/run.ts",
    "test:casefile": "bun test --isolate packages/pi-casefile",
    "test:webxp": "bun test --isolate packages/pi-webxp",
    "test:xtodo": "bun test --isolate packages/pi-xtodo",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "version:patch": "node scripts/bump-version.js patch && bun install --lockfile-only",
    "version:minor": "node scripts/bump-version.js minor && bun install --lockfile-only",
    "version:major": "node scripts/bump-version.js major && bun install --lockfile-only",
    "publish:all": "node scripts/publish-all.js",
    "publish:dry": "npm publish -ws --access public --dry-run"
  }
}
